{
  "name": "little-voice-lab",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "models:download": "node scripts/download-model.mjs && node scripts/download-tts.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:model": "playwright test --grep \"actual offline\" --project desktop-chromium",
    "android:sync": "npm run assets:prepare && npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "lucide-react": "^0.577.0",
    "onnxruntime-web": "1.24.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
